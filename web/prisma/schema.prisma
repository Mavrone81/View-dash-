generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Host {
  id         String           @id @default(uuid())
  name       String           @unique
  lastSeenAt DateTime?
  createdAt  DateTime         @default(now())
  systems    System[]
  enrolments AgentEnrolment[]
}

model System {
  id           String               @id @default(uuid())
  hostId       String
  host         Host                 @relation(fields: [hostId], references: [id], onDelete: Cascade)
  key          String
  displayName  String
  firstSeenAt  DateTime             @default(now())
  observations SystemObservation[]

  // Unique per host, not globally: two hosts may each run a system of the
  // same name, and enrolling the second must not collide with the first.
  @@unique([hostId, key])
}

model SystemObservation {
  id                String    @id @default(uuid())
  systemId          String
  system            System    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  // Two timestamps exist on purpose, and they measure different things:
  // `observedAt` is CLAIMED by the reporting agent (from its own clock, at
  // collection time) — never trust it for staleness, a wrong or malicious
  // agent clock can make it say anything, including a time in the future.
  // `receivedAt` is set by the DATABASE's own `now()` and cannot be
  // influenced by the caller under any circumstances — it is the only
  // timestamp a staleness calculation (now - receivedAt) may trust. Do not
  // delete either as "redundant": `observedAt` stays for diagnosing a
  // skewed host clock; `receivedAt` is the safety-critical one.
  observedAt        DateTime  @default(now())
  receivedAt        DateTime  @default(now())
  health            String
  containersTotal   Int
  containersRunning Int
  deployedSha       String?
  deployedSubject   String?
  deployedAt        DateTime?
  driftCommits      Int?

  // Per-hostname facts derived from the host's own reverse-proxy config --
  // see agent/src/vhosts.ts and shared/src/wire.ts's HostnameConfigSchema.
  // `Json?`, not `String[]`: each entry carries `listensTls` alongside the
  // name (`[{ hostname, listensTls }, ...]`), and a plain string array has
  // nowhere to put that bit.
  //
  // NULL means this observation carries NO OPINION about this system's
  // hostnames -- either it predates this column (an OLDER agent, or any
  // row written before this migration ran), or the reporting agent's vhost
  // read failed on the tick that produced it (see agent/src/collect.ts).
  // An EMPTY ARRAY `[]` is a different, positive fact: a NEWER agent
  // actually read the vhost config this tick and found no hostnames for
  // this system's published ports. Defaulting this column to `'[]'` would
  // make those two cases indistinguishable and render an old row (or a
  // gap tick) as "confirmed no HTTP surface" -- a false claim about a
  // system this observation says nothing about. See ingest.ts for how an
  // absent wire field maps to NULL, never to `[]`.
  hostnames         Json?
  // One entry per on-box probe target this system had this tick:
  // `[{ hostname, outcome, status }, ...]` -- see
  // shared/src/wire.ts's OnBoxProbeResultSchema. `hostname: null` inside an
  // entry means a published port with no vhost mapping (a real, positive
  // fact -- "no name was claimed for this port"), which is a different
  // thing from this WHOLE COLUMN being NULL, which carries the identical
  // "no opinion this observation" meaning as `hostnames` above, for the
  // identical reason.
  onBoxProbes       Json?

  // Rows are selected as "latest observation per system" ordered by
  // receivedAt (the trusted, server-set clock), never observedAt (the
  // untrusted, agent-claimed clock) — see the comment above. The index must
  // match that access pattern, or every query pays for a sort at read time.
  @@index([systemId, receivedAt])
}

/// One external probe's result for ONE hostname, at the time it ran --
/// Task 6's `probeExternally` is the only thing that produces the shape
/// this table stores (see external-probe.ts's `ExternalResult`).
///
/// Stored per HOSTNAME, never per system or per host: a system can carry
/// several hostnames and they can genuinely disagree (that disagreement
/// is spec §8's whole reason for expanding a row) -- keying this table on
/// `hostname`, never on `System.id`, is what keeps a failing hostname
/// visible instead of letting its write average into, or get clobbered
/// by, a sibling hostname's result.
///
/// No unique constraint on `hostname`, and no update-in-place: a fresh row
/// is INSERTED every run. This table is a history, the same shape as
/// `SystemObservation` -- "the latest external result" is a QUERY
/// (`DISTINCT ON ("hostname") ... ORDER BY "observedAt" DESC`, see
/// `fleet-query.ts`'s `latestExternalResultsByHostname`), never a row
/// identity. That is what lets a result persist and AGE across restarts,
/// rather than resetting on every deploy -- Task 7's reviewer relied on
/// the `unconfirmed` window being a cold-start cost, not a recurring gap,
/// and an update-in-place table would still satisfy that, but a history
/// costs nothing extra now and is what a later "how long has this been
/// failing" feature, or a retention pass, would need.
///
/// Purely additive: a brand-new table with no existing rows to migrate,
/// so there is nothing here for old code (running against this schema
/// during a rolling deploy, before new code starts) to be broken by --
/// old code simply never queries a table it does not know exists. A
/// rollback is symmetric: new-schema rows sit unread by old code, nothing
/// to reconcile.
model ExternalProbeResult {
  id       String @id @default(uuid())
  hostname String
  outcome  String
  status   Int?
  // NULL whenever the handshake did not complete, or completed but this
  // probe is not what observed a certificate -- NEVER inferred, and NEVER
  // carried forward from a previous successful probe of the SAME
  // hostname. See `probeExternally`'s own docstring (external-probe.ts)
  // for why: a remembered expiry would let an expired, or now entirely
  // unreachable, certificate read as healthy for as long as the memory
  // lasted -- spec §6's rule, one layer below where §6 states it.
  certExpiresAt DateTime?
  // Set by THIS SERVER's own clock at write time. Unlike
  // `SystemObservation.observedAt` (claimed by a remote agent over the
  // wire, and therefore untrusted -- see that model's own comment), there
  // is no remote clock in this path at all: this process ran the probe
  // and writes the row in the same breath, so one DB-defaulted timestamp
  // is trustworthy on its own and a second "received" column would have
  // nothing distinct left to measure.
  observedAt DateTime @default(now())

  // Serves the per-hostname "latest" query (DISTINCT ON "hostname" ORDER
  // BY "observedAt" DESC) directly, and doubles as what a future
  // age-bounded retention pass would filter on -- see this task's report
  // for why retention is flagged, not built, here.
  @@index([hostname, observedAt])
}

/// One row per RUN of the external prober (Task 9's scheduler calls
/// `runExternalProbes` once per cycle), NOT per hostname -- deliberately a
/// separate table from `ExternalProbeResult` above, and for the opposite
/// storage rule: `ExternalProbeResult` writes NOTHING on a fleet-wide
/// failure (to protect prior good per-hostname evidence from being
/// overwritten by a local network fault -- see external-probe-runner.ts),
/// but the board's fleet-wide banner needs the OPPOSITE: a record of every
/// sweep, INCLUDING the ones that reached nothing, because that is the
/// only honest signal it can be driven from.
///
/// Fix round 1 (Task 8 review): the banner was previously inferred from
/// `isFleetWideExternalFailure` over `latestExternalResultsByHostname`'s
/// per-hostname rows, which has no time bound -- two applications failing
/// three weeks apart could both read as "failing now" and the banner would
/// claim a fleet-wide fault "this cycle" that never happened. This table
/// makes "when did the last sweep run, and did it reach anything" a single,
/// directly-queryable fact instead of an inference over unrelated rows.
model ExternalProbeRun {
  id   String   @id @default(uuid())
  /// Set by THIS SERVER's own clock, same reasoning as
  /// `ExternalProbeResult.observedAt` -- no remote clock in this path.
  ranAt DateTime @default(now())
  /// True unless EVERY hostname probed this run failed (see
  /// `isFleetWideExternalFailure`) -- i.e. the same test that decides
  /// whether `ExternalProbeResult` gets written this run, but recorded
  /// here regardless of the outcome, which is the whole point of this
  /// table existing separately.
  reachedAnything Boolean
  /// Fix round 1 (Task 9 review), M4: how many hostnames this sweep
  /// attempted to probe. A row is now written EVERY cycle, including one
  /// with zero targets (a fleet with no hostnames configured anywhere yet
  /// -- a legitimate, common state, not a failing scheduler); `targetCount`
  /// is what lets a reader tell that apart from "attempted some and reached
  /// none" (`targetCount > 0`, `reachedAnything: false`), which
  /// `reachedAnything` alone cannot do, since both a healthy zero-target
  /// sweep and a fleet-wide-failure-free sweep read `reachedAnything: true`.
  /// `@default(0)` is purely a migration convenience (this table is new in
  /// this same slice and, as of this fix, has never been deployed against
  /// live data) -- every row this code writes going forward always sets it
  /// explicitly.
  targetCount Int @default(0)

  @@index([ranAt])
}

model AgentEnrolment {
  id        String    @id @default(uuid())
  hostId    String
  host      Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Credential {
  id        String   @id @default(uuid())
  label     String
  username  String
  // AES-256-GCM envelope, AAD-bound to `credential:<id>:secret`.
  // There is deliberately no plaintext column anywhere in this model.
  secretSealed String
  notes     String?

  // A LOOSE link, not a foreign key. Systems are discovered and can vanish
  // when a container stops; a credential must survive that and re-attach if
  // the system returns. A relation with a cascade would delete passwords
  // because a container went away.
  hostId    String?
  systemKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rotatedAt DateTime?

  accesses  CredentialAccess[]

  @@index([hostId, systemKey])
}

model VaultConfig {
  id                  String @id @default("singleton")
  kdfParams           String
  verifier            String
  wrappedByPassphrase String
  wrappedByRecovery   String

  // Set when the operator confirms they have stored the recovery key shown
  // once at creation. NULL = never confirmed, which the vault page reports as
  // a standing warning: a recovery key that was displayed and recorded nowhere
  // is a mitigation that is silently absent, and the discovery moment would
  // otherwise be a forgotten passphrase with every credential already lost.
  recoveryKeyAcknowledgedAt DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CredentialAccess {
  id           String   @id @default(uuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  action       String
  at           DateTime @default(now())

  @@index([credentialId, at])
}
