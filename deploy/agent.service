[Unit]
Description=Bevora Ops agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Runs on the MONITORED host (not the dashboard droplet). Reads the local
# container runtime (via the Docker socket), deploy logs, and repo
# checkouts on this host; opens ONE outbound connection to the dashboard's
# `ingest` listener (held open across ticks) PLUS, every tick, a loopback
# HTTP connection to each system's own published port (the on-box probe --
# see agent/src/probe.ts's httpOnBoxRequest). Never binds a listening port
# of its own -- see agent/src/transport.ts and agent/src/main.ts's own
# comments on this. RestrictAddressFamilies below already permits AF_INET,
# so the on-box probe needs no hardening change; this comment is corrected
# only so an auditor reasoning about this unit's egress from the comment
# alone reaches the right conclusion.
# `bevora-agent` is the unit name this file must be installed as
# (`/etc/systemd/system/bevora-agent.service`) -- deploy/verify.sh and
# this file's own [Install] section both assume it.
EnvironmentFile=/etc/bevora-agent/agent.env
ExecStart=/usr/bin/node /opt/bevora-agent/agent-bundle.cjs
Restart=always
RestartSec=5

# --- Identity ----------------------------------------------------------
# ROOT is this unit's default AS SHIPPED -- it requires no setup beyond
# installing this file, and it is an explicit choice, not a silent
# default: see deploy/README.md's note on this trade-off before enabling
# the unit. The commented-out alternative below is equally valid and adds
# real defense-in-depth; uncomment it (and create the account first) if
# you want it instead.
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin bevora-agent
#
# User=bevora-agent
# Group=bevora-agent
# SupplementaryGroups=docker
#
# BE HONEST ABOUT WHAT THIS DOES AND DOES NOT BUY YOU: the Docker socket
# grants root-equivalent access to whoever can reach it, full stop -- a
# member of the `docker` group can run a container with `-v /:/host` and
# read or write anything on this machine as root, exactly as if they were
# root already. Running as a `docker`-group user INSTEAD of literally
# `root` does not contain a compromised agent process from that one
# avenue -- it narrows what OTHER, UNRELATED bugs in this process (now or
# in some future change to it) could reach, e.g. it could not read some
# other service's root-owned secrets file that this one has no business
# touching, where literal root could. That is real, worthwhile
# defense-in-depth against unrelated bugs. It is not a way to sandbox the
# one thing this daemon actually needs.

# --- Hardening -----------------------------------------------------------
# This daemon reaches the Docker socket, which is root-equivalent access by
# design (see the Identity note above) -- because that one avenue cannot be
# sandboxed away, everything ELSE is locked down tightly instead: if this
# process is ever compromised through some other path (a malformed deploy
# log, a bad glob match), it should not gain any capability the agent's own
# code does not already use.
#
# HONESTY CHECK, per this repo's own review process: everything below was
# reasoned through against agent/src/*.ts's actual behavior (it only ever
# READS -- Docker's API, deploy-log files, repo checkouts -- and never
# writes to the filesystem; see agent/src/main.ts, collect.ts, docker.ts,
# deploy-log.ts, git.ts) and against systemd.exec(5)'s documented
# semantics, NOT measured on a real systemd host -- none was available in
# this development environment (macOS has no systemd; `systemd-analyze
# verify` could not be run). On that reasoning: `ProtectSystem=strict`
# makes the filesystem READ-ONLY, not inaccessible, so an agent that never
# writes anywhere should be unaffected by it, and connecting to an
# existing Unix socket (the Docker socket) does not require its mount to
# be writable. But "should be unaffected" is a claim, not a measurement.
# deploy/README.md's enrolment step now says explicitly: smoke-test this
# unit for real on the actual monitored host before trusting it -- a
# service that looks hardened but silently can't reach Docker or its
# configured paths tends to get "fixed" by someone deleting the hardening
# wholesale, which is worse than never having shipped it.
#
# If your AGENT_REPO_ROOT or AGENT_DEPLOY_LOG_GLOB (see agent.env) live
# somewhere ProtectHome=read-only does not cover -- not under /home,
# /root, or /run/user -- and the smoke test above shows a permission
# error reading them, add that one path here rather than loosening
# ProtectSystem/ProtectHome wholesale:
#
# ReadOnlyPaths=/srv/bevora-monitored-repos
NoNewPrivileges=true
ProtectSystem=strict
# `read-only`, not `true`: AGENT_REPO_ROOT and AGENT_DEPLOY_LOG_GLOB (set in
# agent.env) commonly point under a home directory on a small droplet
# (e.g. /home/deploy/apps/...). `ProtectHome=true` would hide /home
# entirely and break both reads; `read-only` still denies this unit any
# write access there.
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute is deliberately NOT set. It forbids memory pages
# that are both writable and executable, which is exactly what V8's JIT
# needs: with it enabled, node dies immediately with a SIGTRAP core dump
# inside the baseline compiler. Verified on a real systemd host — the unit
# looked correct and could not start at all.
# Do not "restore" this directive without re-running the agent under it.
# MemoryDenyWriteExecute=true   # incompatible with any V8/JIT runtime
# AF_UNIX for the Docker socket; AF_INET/AF_INET6 for the outbound
# WebSocket connection to the dashboard AND the on-box probe's loopback
# HTTP connections (see this file's header comment). Nothing else this
# agent does needs any other address family.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
